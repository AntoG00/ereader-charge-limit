# Copy to .adds/chargelimit/config on the reader's USB drive.
# Changes are picked up within POLL seconds, no reboot needed.

# boot: limit from every boot. manual: the reader starts as stock, and the
# limiter only runs after "Start charge limit" in NickelMenu, until "Stop
# charge limit" or the next reboot. manual needs NickelMenu.
START=boot

# 0 hands charging back to the stock driver (the daemon keeps running).
ENABLED=1

# Stop charging at LIMIT %, start again once the battery drops to RESUME %.
LIMIT=80
RESUME=75

# Seconds between checks while the reader is awake.
POLL=30

# While charging below LIMIT, set an RTC wake alarm so a sleeping reader
# wakes up (screen and light stay off) to check. Without it, a reader that
# falls asleep while charging overshoots LIMIT. Seconds between wake-ups.
WAKE_WHILE_CHARGING=1
WAKE_INTERVAL=120
