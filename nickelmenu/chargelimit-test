# NickelMenu items for the manual test in the README, for readers without a
# root shell. Copy this file to .adds/nm/ on the reader's USB drive, and
# kobo-chg to the top level of the drive (/mnt/onboard on the reader).
# The items appear in the home screen's top-left menu.

menu_item :main :Charge status    :cmd_output :5000:/mnt/onboard/kobo-chg status 2>&1; cd /sys/class/power_supply/battery && echo "battery=$(cat capacity)% $(cat status), current_now=$(cat current_now)"
menu_item :main :Charging OFF     :cmd_output :5000:/mnt/onboard/kobo-chg off 2>&1 && echo "charging switched off"
menu_item :main :Charging ON      :cmd_output :5000:/mnt/onboard/kobo-chg on 2>&1 && echo "charging switched on"
menu_item :main :Charge driver log:cmd_output :5000:dmesg | grep -iE 'PMU|bd7182|charg' | tail -n 8
menu_item :main :Charge limit log :cmd_output :5000:tail -n 10 /tmp/chargelimit.log 2>&1
menu_item :main :Charge diagnostics:cmd_output :5000:cd /sys/bus/i2c/devices && for d in *; do echo "$d=$(cat $d/name)"; done; ls /dev | grep -i i2c; ls /sys/class/power_supply; readlink -f /sys/class/power_supply/battery/device
