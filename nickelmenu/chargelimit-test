# Developer NickelMenu items for testing without a root shell: raw output and
# a direct charging switch. Copy this file to .adds/nm/ on the reader's USB
# drive; the items use the installed package (KoboRoot.tgz). Users don't need
# it: the package writes its own menu (.adds/nm/chargelimit), and the
# diagnostics report covers the chip, I2C and sysfs listings.

menu_item :main :Dev status :cmd_output :5000:/usr/local/chargelimit/kobo-chg status 2>&1; cd /sys/class/power_supply/battery && echo "status=$(cat status) current_now=$(cat current_now) charging=$(cat charging 2>&1)"
menu_item :main :Dev charging on/off :cmd_output :5000:c=/usr/local/chargelimit/kobo-chg; if $c status | grep -q '^charging_enabled=1'; then $c off 2>&1 && echo "charging switched off"; else $c on 2>&1 && echo "charging switched on"; fi; echo "While the limit is on, the daemon may undo this within 30 s."
menu_item :main :Dev log :cmd_output :5000:tail -n 12 /tmp/chargelimit.log 2>/dev/null || echo "no log yet"
menu_item :main :Dev kernel log :cmd_output :5000:dmesg | grep -iE 'PMU|bd7182|charg' | tail -n 6; cd /sys/class/rtc/rtc0 && echo "alarm=$(cat wakealarm) now=$(date +%s) wakeups=$(cat device/power/wakeup_count 2>&1)"; dmesg | grep -E 'Suspending system|suspend exit' | tail -n 4
menu_item :main :Dev save logs :cmd_output :9000:d=/mnt/onboard/chargelimit-logs; mkdir -p $d && cp /tmp/chargelimit.log /tmp/chargelimit.activity $d/ 2>/dev/null; dmesg > $d/dmesg.txt; cat /sys/class/rtc/rtc0/device/power/wakeup_count > $d/rtc-wakeups.txt; cp /mnt/onboard/.adds/chargelimit/config $d/ 2>/dev/null; uptime > $d/uptime.txt; ls $d
