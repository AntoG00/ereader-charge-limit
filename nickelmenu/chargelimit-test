# NickelMenu items for the manual test in the README, for readers without a
# root shell. Copy this file to .adds/nm/ on the reader's USB drive; the items
# use the installed package (KoboRoot.tgz).
# The items appear in the home screen's top-left menu.

menu_item :main :Start charge limit:cmd_output :5000:echo started > /tmp/chargelimit.state; /usr/local/chargelimit/launch.sh; sleep 2; tail -n 2 /tmp/chargelimit.log
menu_item :main :Stop charge limit:cmd_output :5000:echo stopped > /tmp/chargelimit.state; /usr/local/chargelimit/launch.sh; sleep 2; tail -n 2 /tmp/chargelimit.log
menu_item :main :Charge status    :cmd_output :5000:/usr/local/chargelimit/kobo-chg status 2>&1; cd /sys/class/power_supply/battery && echo "battery=$(cat capacity)% $(cat status), current_now=$(cat current_now)"
menu_item :main :Charging OFF     :cmd_output :5000:/usr/local/chargelimit/kobo-chg off 2>&1 && echo "charging switched off"
menu_item :main :Charging ON      :cmd_output :5000:/usr/local/chargelimit/kobo-chg on 2>&1 && echo "charging switched on"
menu_item :main :Charge driver log:cmd_output :5000:dmesg | grep -iE 'PMU|bd7182|charg' | tail -n 8
menu_item :main :Charge limit log :cmd_output :5000:tail -n 10 /tmp/chargelimit.log 2>&1
menu_item :main :Wake log         :cmd_output :5000:cd /sys/class/rtc/rtc0 && echo "alarm=$(cat wakealarm) now=$(date +%s)" && echo "rtc wakeup=$(cat device/power/wakeup 2>&1) count=$(cat device/power/wakeup_count 2>&1)"; dmesg | grep -E 'Suspending system|suspend exit' | tail -n 12
menu_item :main :Write diagnostics:cmd_output :9000:mkdir -p /mnt/onboard/.adds/chargelimit && /usr/local/chargelimit/diagnostics.sh > /mnt/onboard/.adds/chargelimit/diagnostics.txt 2>&1; sed -n '/== verdict ==/,/supported:/p' /mnt/onboard/.adds/chargelimit/diagnostics.txt
menu_item :main :Save logs to USB :cmd_output :9000:d=/mnt/onboard/chargelimit-logs; mkdir -p $d && cp /tmp/chargelimit.log $d/ ; dmesg > $d/dmesg.txt; cat /sys/class/rtc/rtc0/device/power/wakeup_count > $d/rtc-wakeups.txt; cp /mnt/onboard/.adds/chargelimit/config $d/ 2>/dev/null; uptime > $d/uptime.txt; ls $d
menu_item :main :Charge sysfs     :cmd_output :5000:cd /sys/class/power_supply/battery && ls; echo "charging=$(cat charging 2>&1)"
menu_item :main :Sysfs charging ON :cmd_output :5000:(echo 1 > /sys/class/power_supply/battery/charging) 2>&1; echo "charging=$(cat /sys/class/power_supply/battery/charging 2>&1)"
menu_item :main :Sysfs charging OFF:cmd_output :5000:(echo 0 > /sys/class/power_supply/battery/charging) 2>&1; echo "charging=$(cat /sys/class/power_supply/battery/charging 2>&1)"
menu_item :main :Charge diagnostics:cmd_output :5000:cd /sys/bus/i2c/devices && for d in *; do echo "$d=$(cat $d/name)"; done; ls /dev | grep -i i2c; ls /sys/class/power_supply; readlink -f /sys/class/power_supply/battery/device
